# Public nginx port. The API is only reachable on the Compose network.
ES_PORT=8670
# Set this to the exact browser origin for a different hostname or HTTPS entry.
# When omitted, Compose uses http://127.0.0.1:${ES_PORT}.
# ACCESS_PUBLIC_URL=https://compiler.example.com

# Required for the first administrator when entering through nginx.
# Generate a private value with: openssl rand -hex 32
# Do not leave an empty assignment: omit this variable when setup is locked.
# ACCESS_SETUP_TOKEN=replace-with-a-random-32-to-512-character-value

# Optional provider credentials; callbacks use ACCESS_PUBLIC_URL.
# ACCESS_GITHUB_CLIENT_ID=
# ACCESS_GITHUB_CLIENT_SECRET=
# ACCESS_GOOGLE_CLIENT_ID=
# ACCESS_GOOGLE_CLIENT_SECRET=
